# ---------------------------------------------------------------------------
# JTL-Wawi Read-Only MCP Server - Beispielkonfiguration
#
# Kopieren nach `.env` und an die eigene Umgebung anpassen:
#   cp .env.example .env && chmod 600 .env
# ---------------------------------------------------------------------------

# --- JTL-Wawi REST-API -----------------------------------------------------
# Basis-URL des JTL-Wawi-API-Servers (JTL.Wawi.Rest.exe, Standardport 5883).
JTL_BASE_URL=http://wawi-api-intern:5883

# Pfad-Präfix der API:
#   /api/eazybusiness/v1  -> JTL-Wawi API (empfohlen, ab JTL-Wawi 1.9/2.0)
#   /rest/eazybusiness/v1 -> in JTL-Wawi integrierter REST-Server
JTL_API_PATH=/api/eazybusiness/v1

# API-Key aus JTL-Wawi: Admin -> Benutzer/Rechte -> Benutzer -> "Key erzeugen".
# Der Key wird standardmaessig base64-kodiert und als Bearer-Token gesendet.
JTL_API_KEY=hier-den-api-key-eintragen

# true, falls JTL_API_KEY bereits base64-kodiert ist.
JTL_API_KEY_B64=false

# Optional: App-Id der registrierten App (nur Dokumentation).
JTL_APP_ID=
JTL_APP_VERSION=1.0.0

# Timeout / Retries
JTL_TIMEOUT=20
JTL_CONNECT_TIMEOUT=10
JTL_MAX_RETRIES=3
JTL_BACKOFF_SECONDS=0.5

# TLS-Zertifikate pruefen (in Produktion true lassen).
JTL_VERIFY_TLS=true

# Seitengrenzen fuer Listenabfragen
JTL_PAGE_SIZE=50
JTL_MAX_PAGE_SIZE=200

# --- MCP-Server ------------------------------------------------------------
# Statisches Bearer-Token, das der MCP-Server von LiteLLM erwartet.
# Erzeugen z. B. mit: openssl rand -hex 32
MCP_SERVER_AUTH_TOKEN=hier-ein-langes-zufaelliges-token-eintragen

# Bind-Adresse und Port (MCP-Endpunkt: http://<host>:8080/mcp)
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp

# Host-/Origin-Protection (Kommagetrennte Listen, optional).
# Sind MCP_ALLOWED_HOSTS gesetzt, wird die Pruefung aktiviert.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Stateless-Modus des Streamable-HTTP-Transports (empfohlen fuer Load-Balancer).
MCP_STATELESS_HTTP=false

MCP_LOG_LEVEL=INFO
